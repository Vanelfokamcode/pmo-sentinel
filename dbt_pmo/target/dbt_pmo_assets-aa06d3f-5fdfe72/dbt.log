{"data": {"conn_name": "model.pmo_sentinel.fct_pmo_portfolio", "node_info": {"materialized": "table", "meta": {}, "node_checksum": "f2e97522d2b88a5c675f538a9bf242f9d8d70fe7a9de671ab888f3171d63fcc1", "node_finished_at": "", "node_name": "fct_pmo_portfolio", "node_path": "marts/fct_pmo_portfolio.sql", "node_relation": {"alias": "fct_pmo_portfolio", "database": "pmo_sentinel", "relation_name": "\"pmo_sentinel\".\"main\".\"fct_pmo_portfolio\"", "schema": "main"}, "node_started_at": "2026-05-16T18:29:41.043889", "node_status": "executing", "resource_type": "model", "unique_id": "model.pmo_sentinel.fct_pmo_portfolio"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.9\", \"profile_name\": \"pmo_sentinel\", \"target_name\": \"dev\", \"node_id\": \"model.pmo_sentinel.fct_pmo_portfolio\"} */\n\n  \n    \n    \n\n    create  table\n      \"pmo_sentinel\".\"main\".\"fct_pmo_portfolio__dbt_tmp\"\n  \n    as (\n      with projects as (\n    select * from \"pmo_sentinel\".\"main\".\"stg_pmo_projets\"\n)\n\nselect\n    *,\n    -- Taux de consommation du budget (Burn Rate)\n    round((budget_consomme_k / nullif(budget_prevu_k, 0)) * 100, 2) as burn_rate_pct,\n    \n    -- Pourcentage d'avancement des jalons\n    round((nb_jalons_valides::FLOAT / nullif(nb_jalons_total, 0)) * 100, 2) as progress_pct,\n    \n    -- Logique de Scoring RAG (Red / Amber / Green)\n    -- On automatise ce que Marilyne fait \u00e0 la main\n    case \n        when statut = 'Bloqu\u00e9' or retard_jours > 30 or (budget_consomme_k > budget_prevu_k * 1.2) then 'RED'\n        when statut = '\u00c0 risque' or retard_jours > 0 or (budget_consomme_k > budget_prevu_k) then 'AMBER'\n        else 'GREEN'\n    end as rag_status\nfrom projects\n    );\n  \n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "49b119d6-222f-40eb-8451-0e9846eb3650", "level": "debug", "msg": "On model.pmo_sentinel.fct_pmo_portfolio: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.9\", \"profile_name\": \"pmo_sentinel\", \"target_name\": \"dev\", \"node_id\": \"model.pmo_sentinel.fct_pmo_portfolio\"} */\n\n  \n    \n    \n\n    create  table\n      \"pmo_sentinel\".\"main\".\"fct_pmo_portfolio__dbt_tmp\"\n  \n    as (\n      with projects as (\n    select * from \"pmo_sentinel\".\"main\".\"stg_pmo_projets\"\n)\n\nselect\n    *,\n    -- Taux de consommation du budget (Burn Rate)\n    round((budget_consomme_k / nullif(budget_prevu_k, 0)) * 100, 2) as burn_rate_pct,\n    \n    -- Pourcentage d'avancement des jalons\n    round((nb_jalons_valides::FLOAT / nullif(nb_jalons_total, 0)) * 100, 2) as progress_pct,\n    \n    -- Logique de Scoring RAG (Red / Amber / Green)\n    -- On automatise ce que Marilyne fait \u00e0 la main\n    case \n        when statut = 'Bloqu\u00e9' or retard_jours > 30 or (budget_consomme_k > budget_prevu_k * 1.2) then 'RED'\n        when statut = '\u00c0 risque' or retard_jours > 0 or (budget_consomme_k > budget_prevu_k) then 'AMBER'\n        else 'GREEN'\n    end as rag_status\nfrom projects\n    );\n  \n  ", "name": "SQLQuery", "pid": 12027, "thread": "Thread-1 (worker)", "ts": "2026-05-16T18:29:41.186214Z"}}
